# ----------------------------------------------------------------------
# RVS UNIVERSITY — GoDaddy Production Apache Configuration (.htaccess)
# ----------------------------------------------------------------------

# 1. Explicit MIME Types for JavaScript Modules & Assets (Fixes MIME type error)
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
  AddType image/svg+xml .svg .svgz
  AddType image/webp .webp
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType video/mp4 .mp4 .m4v
  AddType video/webm .webm
</IfModule>

# 2. React SPA Client-Side Routing (Fail-safe for GoDaddy)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow direct access to existing files and directories (assets, images, videos, php)
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# 3. Enable Range Requests for Fast Video Playback / Streaming
<IfModule mod_headers.c>
  Header set Accept-Ranges bytes
</IfModule>

# 4. Compression for Fast Load (Brotli & Gzip)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript text/javascript application/json image/svg+xml application/x-javascript
</IfModule>

# 5. High-Speed Browser Caching (1 Year for Immutable Assets, 1 Month for Images)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # 1 Year Cache for static assets with immutable directive
  <FilesMatch "\.(css|js|webp|png|jpg|jpeg|gif|svg|woff2?|ttf|eot)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
  # HTML pages revalidate immediately
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
