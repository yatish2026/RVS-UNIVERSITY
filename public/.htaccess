# ----------------------------------------------------------------------
# RVS UNIVERSITY — GoDaddy Production Apache Configuration (.htaccess)
# ----------------------------------------------------------------------

# 1. Enable URL Rewriting for React SPA Client-side Routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not rewrite actual files or directories (e.g. mail.php, videos, images, assets)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other URLs to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# 2. MIME Types for Modern Web Assets & Video Streaming
<IfModule mod_mime.c>
  AddType video/mp4 .mp4 .m4v
  AddType video/webm .webm
  AddType application/json .json
  AddType image/svg+xml .svg .svgz
  AddType image/webp .webp
  AddType application/javascript .js
  AddType text/css .css
</IfModule>

# 3. Enable Range Requests for Fast Video Playback / Streaming (160MB MP4 support)
<IfModule mod_headers.c>
  Header set Accept-Ranges bytes
</IfModule>

# 4. Gzip / Deflate Compression for High Performance
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# 5. Security & Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
